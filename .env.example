ANTHROPIC_API_KEY=

POSTGRES_USER=openbrain
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openbrain
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Points at the host's existing Ollama instance (already running nomic-embed-text)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

CAPTURE_API_PORT=8080
MCP_SERVER_PORT=8765

# Bearer tokens (openssl rand -hex 32). Both servers refuse to start if
# either is unset. Write also grants read. See README.md.
OPENBRAIN_READ_TOKEN=
OPENBRAIN_WRITE_TOKEN=
