#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${OPENBRAIN_CAPTURE_URL:-http://localhost:8080}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "${OPENBRAIN_TOKEN:-}" ]; then
    echo "OPENBRAIN_TOKEN is not set (need the write token) — see .env / ~/.bashrc" >&2
    exit 1
fi

if [ $# -gt 0 ]; then
    text="$*"
else
    text="$(cat)"
fi

if [ -z "$text" ]; then
    echo "Usage: brain-capture \"some thought\"  (or pipe text via stdin)" >&2
    exit 1
fi

# Auto-scope to the current directory's project (git remote, or a path
# fallback), same logic the SessionStart hook uses to load rules back —
# see cli/scope.sh. Empty means global, same as leaving scope unset.
scope="$("$SCRIPT_DIR/scope.sh")"
if [ -n "$scope" ]; then
    payload=$(jq -n --arg text "$text" --arg scope "$scope" '{text: $text, source: "cli", scope: $scope}')
else
    payload=$(jq -n --arg text "$text" '{text: $text, source: "cli"}')
fi

curl -sf -X POST "$BASE_URL/capture" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $OPENBRAIN_TOKEN" \
    -d "$payload" | jq .
